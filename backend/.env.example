JWT_SECRET=cambia-esto-por-una-cadena-larga-y-aleatoria
GROQ_API_KEY=

# --- SMTP ---
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=tls
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@example.com
SMTP_FROM_NAME=TempliMail

# --- Base de datos (Docker: host=db | XAMPP: host=localhost) ---
DB_HOST=db
DB_PORT=3306
DB_NAME=templimail_db
DB_USER=root
DB_PASSWORD=

# --- API ---
# Origen permitido por CORS (el frontend)
CORS_ORIGIN=http://localhost:4200
# URL publica de la API: se usa para el enlace de baja de los correos
PUBLIC_API_URL=http://localhost:8080/backend/api/index.php

# --- Envio ---
# Pausa entre correos de una campana (ms) e intentos por destinatario
MAIL_THROTTLE_MS=200
MAIL_MAX_ATTEMPTS=3
